{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendario",
  "main": "worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "PORTAL_ORIGIN": "https://portal.camaraceuta.workers.dev",
    "EMBED_PARENT_ORIGIN": "https://portal-jornadas.pages.dev",
    "SUPABASE_URL": "https://oqeyynrgustgotpcoewh.supabase.co"
  },
  "observability": {
    "enabled": true
  }
}
